<UserControl
    x:Class="Logazmic.Views.LogPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviours="clr-namespace:Logazmic.Behaviours"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:controls="clr-namespace:Logazmic.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:filters="clr-namespace:Logazmic.ViewModels.Filters"
    xmlns:log="clr-namespace:Logazmic.Core.Log"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="clr-namespace:Logazmic.Settings"
    xmlns:viewModels="clr-namespace:Logazmic.ViewModels"
    d:DataContext="{d:DesignInstance viewModels:LogPaneViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="300"
    Focusable="False"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  Styles to ovveride grid foreground  -->
        <Style
            x:Key="CellStyle"
            BasedOn="{StaticResource MetroDataGridCell}"
            TargetType="{x:Type DataGridCell}">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=DataGridRow}}" />
        </Style>

        <Style
            x:Key="RowStyle"
            BasedOn="{StaticResource MetroDataGridRow}"
            TargetType="{x:Type DataGridRow}">
            <Style.Triggers>
                <!--  ReSharper disable Xaml.BindingWithContextNotResolved  -->
                <DataTrigger Binding="{Binding LogLevel, Mode=OneTime}" Value="{x:Static log:LogLevel.Trace}">
                    <Setter Property="Foreground" Value="{DynamicResource TraceColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LogLevel, Mode=OneTime}" Value="{x:Static log:LogLevel.Debug}">
                    <Setter Property="Foreground" Value="{DynamicResource DebugColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LogLevel, Mode=OneTime}" Value="{x:Static log:LogLevel.Info}">
                    <Setter Property="Foreground" Value="{DynamicResource InfoColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LogLevel, Mode=OneTime}" Value="{x:Static log:LogLevel.Warn}">
                    <Setter Property="Foreground" Value="{DynamicResource WarnColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LogLevel, Mode=OneTime}" Value="{x:Static log:LogLevel.Error}">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorColor}" />
                    <Setter Property="FontWeight" Value="DemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LogLevel, Mode=OneTime}" Value="{x:Static log:LogLevel.Fatal}">
                    <Setter Property="Foreground" Value="{DynamicResource FatalColor}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <!--  ReSharper restore Xaml.BindingWithContextNotResolved  -->
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailsTextBlock" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <DataGrid
            x:Name="LogDataGrid"
            controls:DataGridBehavior.Autoscroll="{Binding AutoScroll}"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserResizeRows="False"
            CellStyle="{StaticResource CellStyle}"
            FontSize="{Binding Source={x:Static settings:LogazmicSettings.Instance}, Path=GridFontSize}"
            GridLinesVisibility="{Binding Source={x:Static settings:LogazmicSettings.Instance}, Path=GridLinesVisibility}"
            ItemsSource="{Binding Path=CollectionViewSource.View}"
            RowStyle="{StaticResource RowStyle}"
            SelectedItem="{Binding Path=SelectedLogMessage}"
            SelectionMode="Single">
            <DataGrid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="Red" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <!--  ReSharper disable Xaml.BindingWithContextNotResolved  -->
                <DataGridTextColumn
                    Binding="{Binding Path=TimeStamp, Converter={StaticResource DateTimeToStringConverter}}"
                    Header="Time"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Binding="{Binding Path=LogLevel}"
                    Header="Level"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Binding="{Binding Path=LastLoggerName}"
                    Header="Logger"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Binding="{Binding Path=ThreadName}"
                    Header="Thread"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Path=MessageSingleLine}"
                    Header="Message"
                    IsReadOnly="True" />
                <!--  ReSharper restore Xaml.BindingWithContextNotResolved  -->
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter
            Grid.Row="0"
            Grid.Column="1"
            Width="3"
            HorizontalAlignment="Stretch"
            ResizeDirection="Columns" />

        <Grid
            x:Name="Tree"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="2">
            <DockPanel>
                <UniformGrid Columns="1" DockPanel.Dock="Top">
                    <UniformGrid Rows="1">
                        <Button cal:Message.Attach="CheckUncheck('false')" Content="Uncheck" />
                        <Button cal:Message.Attach="CheckUncheck('true')" Content="Check" />
                        <Button cal:Message.Attach="CollapseExpand('false')" Content="Collapse" />
                        <Button cal:Message.Attach="CollapseExpand('true')" Content="Expand" />
                    </UniformGrid>
                    <DockPanel>
                        <Button
                            cal:Message.Attach="ClearSearchText"
                            Content="x"
                            DockPanel.Dock="Right" />
                        <TextBox DockPanel.Dock="Left" Text="{Binding SearchSourceText, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </UniformGrid>
                <TreeView
                    Margin="5"
                    VerticalAlignment="Stretch"
                    DockPanel.Dock="Bottom"
                    ItemsSource="{Binding Path=ProfileFiltersViewModel.SourceFilterRootViewModel.Children}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type filters:SourceFilterViewModel}" ItemsSource="{Binding Path=Children}">
                            <CheckBox IsChecked="{Binding Path=IsChecked}">
                                <ContentPresenter VerticalAlignment="Center" Content="{Binding Name, Mode=OneTime}" />
                            </CheckBox>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding Path=IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding Path=IsSelected, Mode=TwoWay}" />
                            <EventSetter Event="Selected" Handler="TreeViewSelectedItemChanged" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </DockPanel>
        </Grid>

        <GridSplitter
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Height="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            behaviours:GridSplitterBehaviour.SaveSizeWithName="MainWindow.Description" />

        <Grid
            x:Name="Details"
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="3">
            <TextBox
                Margin="10"
                VerticalAlignment="Top"
                FontFamily="Courier New"
                FontSize="{Binding Source={x:Static settings:LogazmicSettings.Instance}, Path=DescriptionFontSize}"
                Style="{StaticResource DetailsTextBlock}"
                Text="{Binding Path=SelectedLogMessage.Message, Mode=OneWay}"
                TextWrapping="Wrap" />

        </Grid>
    </Grid>
</UserControl>